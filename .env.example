# --- Banco: o MESMO PostgreSQL do Sentinela (copie do .env do DetectHumans) ---
PGHOST=servidor
PGPORT=5432
PGDATABASE=sentinela
PGUSER=usuario
PGPASSWORD=senha
# ou: DATABASE_URL=postgresql://usuario:senha@servidor:5432/sentinela

# --- API do WhatsApp (projeto whatsapp-api) ---
WHATSAPP_API_URL=http://localhost:3000
WHATSAPP_SESSAO=ABCD
WHATSAPP_API_KEY=            # mesmo valor de API_KEY no .env da whatsapp-api

# --- Foto do alerta (opcional) ---
SENTINELA_API_URL=http://localhost:8000
SENTINELA_PASTA=C:\DetectHumans   # alternativa: lê a foto direto da pasta
SENTINELA_PAINEL_URL=             # link incluído na mensagem, ex.: http://192.168.0.10:8000

# --- Telefones sem DDD/país ---
TELEFONE_DDD_PADRAO=65
TELEFONE_PAIS=55

# --- Laço ---
NOTIF_INTERVALO_S=3
NOTIF_JANELA_MIN=10         # só alertas dos últimos N minutos
NOTIF_MAX_TENTATIVAS=3
NOTIF_MODO_TESTE=false      # true: resolve e registra, mas não envia
