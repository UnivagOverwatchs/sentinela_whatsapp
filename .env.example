# --- Banco: o MESMO PostgreSQL do Sentinela (copie do .env do DetectHumans) ---
PGHOST=servidor
PGPORT=5432
PGDATABASE=sentinela
PGUSER=usuario
PGPASSWORD=senha
# ou: DATABASE_URL=postgresql://usuario:senha@servidor:5432/sentinela

# --- API do WhatsApp (projeto whatsapp-api) ---
# No Docker (compose.yaml) a URL é definida automaticamente como http://whatsapp-api:3000.
WHATSAPP_API_URL=http://localhost:3000
WHATSAPP_SESSAO=ABCD
# chave da whatsapp-api (no Docker, a mesma é aplicada nos dois serviços)
WHATSAPP_API_KEY=

# --- Foto do alerta (opcional) ---
SENTINELA_API_URL=http://localhost:8000
# alternativa: lê a foto direto da pasta
SENTINELA_PASTA=C:\DetectHumans
# link incluído na mensagem, ex.: http://192.168.0.10:8000
SENTINELA_PAINEL_URL=

# --- Telefones sem DDD/país ---
TELEFONE_DDD_PADRAO=65
TELEFONE_PAIS=55

# --- Laço ---
NOTIF_INTERVALO_S=3
# só alertas dos últimos N minutos
NOTIF_JANELA_MIN=10
NOTIF_MAX_TENTATIVAS=3
# true: resolve e registra, mas não envia
NOTIF_MODO_TESTE=false

# --- API HTTP do notificador (o Sentinela chama POST /notificar) ---
NOTIF_HTTP_PORTA=8100
# gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIF_TOKEN=
